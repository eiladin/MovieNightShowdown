# Env / secrets
# `.env` matches that exact name only, so variants such as `.env.bak` were not
# covered. Ignore the whole family and re-admit the committed template.
.env
.env.*
!.env.example
*.local
*.bak

# The config file the app writes at runtime. It holds credentials in plaintext
# and the setup token, and a local `go run .` creates it here by default.
/config/

# Go
/movie-night-showdown
*.exe
*.test
*.out

# Node / Vite
web/node_modules/
web/dist/
npm-debug.log*
yarn-error.log*

# Screenshot pipeline (scripts/screenshots/README.md)
scripts/screenshots/node_modules/

# Editor / OS
.DS_Store
.idea/
.vscode/

# Working directory for the screenshot pipeline (scripts/screenshots/run.sh).
.screenshots-run/
