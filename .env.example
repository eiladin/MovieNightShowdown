JELLYFIN_URL=https://jellyfin.example.com
JELLYFIN_API_KEY=replace-me
JELLYFIN_USER_ID=
# TMDB v4 API Read Access Token. Optional: without it only Jellyfin is
# available as a source; with it Netflix, Prime Video, and Disney+ can be
# selected. Stays server-side and is never sent to clients.
TMDB_READ_TOKEN=
PUBLIC_URL=http://localhost:8080
PORT=8080
SESSION_TTL=4h
