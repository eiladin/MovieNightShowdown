# This file is optional. Everything below can be set from the app's settings
# screen instead, which is the usual way: start the app with none of this,
# read the setup token from its log, and open /settings.
#
# What is here SEEDS a deployment that has not saved a value for a setting yet.
# Once the settings screen saves one, the config file wins and the variable here
# is ignored -- the startup log says so per setting. See docs/INSTALL.md, "How
# settings are resolved".
#
# The app needs at least one movie source: Jellyfin, Plex, streaming, or any
# combination. With none of them configured anywhere, it serves only its /setup
# page, which points at the settings screen.

# --- Source 1: your Jellyfin library -----------------------------------------
# Both of these are needed together. The API key stays server-side and is never
# sent to clients. Create it in Jellyfin under Dashboard -> API Keys.
JELLYFIN_URL=https://jellyfin.example.com
JELLYFIN_API_KEY=replace-me
# Optional, and only needed for the "unwatched only" filter.
JELLYFIN_USER_ID=

# --- Source 2: a Plex library ------------------------------------------------
# Both of these are needed together. The token stays server-side and is never
# sent to clients. Find it in Plex Web: open any movie's ... menu -> Get Info ->
# View XML, then copy the X-Plex-Token value out of the address bar.
PLEX_URL=
PLEX_TOKEN=
# Optional: the library section holding movies. Discovered automatically when
# unset; set it only if your server has more than one movie library.
PLEX_LIBRARY_SECTION=

# --- Source 3: streaming services --------------------------------------------
# TMDB v4 API Read Access Token, from https://www.themoviedb.org/settings/api
# (the long v4 token, not the shorter v3 key). It enables Netflix, Prime Video,
# and Disney+ as sources. Without it, streaming is not offered at all. Stays
# server-side and is never sent to clients.
TMDB_READ_TOKEN=
# Optional: which streaming services to offer, comma-separated. Any watch
# provider TMDB tracks can be named -- not just the three below. Entries are
# provider names (netflix, hulu, peacock, "hbo max") or numeric TMDB provider
# ids (15, 386, 1899); the two can be mixed. Unset means netflix,prime,disney --
# but only for a deployment that has not saved streaming settings. Once the
# settings screen manages them, services are chosen explicitly or not at all.
# Unrecognized entries are logged and skipped, never fatal. Has no effect
# without TMDB_READ_TOKEN. See docs/INSTALL.md for how to look up an id.
STREAMING_PROVIDERS=
# Optional: ISO 3166-1 country code, defaults to US. Decides which streaming
# services exist and what they carry, so set it if you are not in the US.
TMDB_WATCH_REGION=

# --- Everything else ----------------------------------------------------------
# The address people's phones use to reach the app; it is what the QR code
# points at, so it must be reachable from their devices.
PUBLIC_URL=http://localhost:8080
SESSION_TTL=4h

# --- Deployment-level ---------------------------------------------------------
# These three are environment-only: each names something established before the
# process starts, so the settings screen reports them but cannot change them.
# Changing one means editing this file (or the compose file) and recreating the
# container.
PORT=8080
# Where posters are cached. Mount a volume here to keep the cache across
# restarts.
CACHE_DIR=
# Where the app stores the settings it writes, including your credentials and
# its setup token. Mount a volume for its directory, or everything you configure
# is forgotten on the next restart. Defaults to ./config/config.yaml.
CONFIG_FILE=
